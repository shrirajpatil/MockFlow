# REQUIRED: ngrok authentication token — ngrok rejects unauthenticated sessions.
# Free account: https://dashboard.ngrok.com/signup
# Then copy your token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=

# Port to tunnel (default: 3000 for Next.js frontend)
TUNNEL_PORT=3000

# Optional: Custom subdomain (requires ngrok auth and paid plan)
# Example: NGROK_SUBDOMAIN=my-mockflow
NGROK_SUBDOMAIN=

# Optional: Region (us, eu, ap, au, sa, jp, in)
NGROK_REGION=us
