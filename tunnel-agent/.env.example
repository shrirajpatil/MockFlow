# Optional: ngrok authentication token (for stable URLs and custom subdomains)
# Get your token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=

# Port to tunnel (default: 3000 for Next.js frontend)
TUNNEL_PORT=3000

# Optional: Custom subdomain (requires ngrok auth and paid plan)
# Example: NGROK_SUBDOMAIN=my-mockflow
NGROK_SUBDOMAIN=

# Optional: Region (us, eu, ap, au, sa, jp, in)
NGROK_REGION=us
