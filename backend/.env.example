# Backend (Netlify Functions) environment — set these in Netlify UI for production,
# or in a root .env when running `netlify dev` locally.

# Supabase (service role key: Settings → API → service_role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Upstash Redis — optional but recommended (persistent mock state, rate limiting, caching)
UPSTASH_REDIS_URL=https://your-db.upstash.io
UPSTASH_REDIS_TOKEN=your-token

# Proxy CORS whitelist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,https://your-site.netlify.app

# Tuning (optional)
# REDIS_DEPLOYED_TTL=60     # seconds a deployed route stays cached
# REDIS_STATE_TTL=3600      # seconds State-node values persist
# REDIS_RATELIMIT_MAX=100   # requests per window per IP
# REDIS_RATELIMIT_WINDOW=60 # window in seconds
